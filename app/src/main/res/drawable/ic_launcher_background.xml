<?xml version="1.0" encoding="utf-8"?>
<!-- 앱 아이콘 배경. 원본 아이콘의 세로 그라데이션(#E8EEF2 -> #BBC5CC)을 벡터로 재현해
     밀도와 무관하게 선명하게 그려지도록 한다. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item
                    android:color="#E8EEF2"
                    android:offset="0.0" />
                <item
                    android:color="#BBC5CC"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
